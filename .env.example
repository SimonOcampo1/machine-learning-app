# Google Cloud Console → APIs y servicios → Credenciales → ID de cliente de OAuth (app web)
# Orígenes autorizados: http://localhost:3000 y la URL de producción de Vercel
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# OPCIONAL, y vacia por defecto: el sitio es ABIERTO.
# Sin definir, cualquier cuenta de Google verificada puede loguearse y guardar
# su progreso. Con correos separados por coma, se vuelve una allowlist y todo
# el resto recibe 401. Es un interruptor de entorno, no de codigo: se cierra
# desde el panel de Vercel sin volver a desplegar.
EMAILS_PERMITIDOS=

# Los pone solo la integración de Upstash desde el Marketplace de Vercel
KV_REST_API_URL=
KV_REST_API_TOKEN=
